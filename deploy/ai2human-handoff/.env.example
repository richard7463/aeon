# AI2Human Handoff — server environment
# Copy to .env (chmod 600) and fill in. Never commit .env.

# Required
AI2HUMAN_AGENT_KEY=your_agent_api_key

# Optional — default is https://ai2human.io
# AI2HUMAN_BASE_URL=https://ai2human.io

# Set true to force dry-run for every intent (safe for staging)
# AI2HUMAN_DRY_RUN=false

# Notification channels (optional, at least one recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
